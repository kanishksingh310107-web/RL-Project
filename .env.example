# Geoapify API Key (Required for live geocoding, places, and accommodations)
# Register for a free tier key (3000 credits/day, no credit card required) at https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Google OAuth Client ID (Optional, for Google Sign-in on local test domains)
GOOGLE_CLIENT_ID=

# Auth Secret Key (Optional session encryption key)
AUTH_SECRET_KEY=dev_secret_key_123
